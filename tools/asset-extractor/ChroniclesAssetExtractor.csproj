<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Cue4ParseProject Condition="'$(Cue4ParseProject)' == ''">$(MSBuildThisFileDirectory)../../out/dependencies/CUE4Parse/CUE4Parse/CUE4Parse.csproj</Cue4ParseProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Cue4ParseProject)" AdditionalProperties="CUE4PARSE_SKIP_NATIVE=true;DirectoryPackagesPropsPath=$(MSBuildThisFileDirectory)dependency-versions.props" />
  </ItemGroup>
  <Target Name="CheckArchiveDependencies" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(Cue4ParseProject)')"
           Text="Fetch the pinned CUE4Parse source first; see docs/guides/game-data.md." />
  </Target>
</Project>
