    "distribution": [],
    "protocol": ["common"],
    "data": ["common", "protocol"],
    "persistence": ["common", "data"],
    "auth": ["common", "distribution", "protocol", "data", "persistence"],
    "net": ["common", "protocol"],
    "world/core": ["common", "distribution", "protocol", "data", "persistence", "auth", "net"],
    "world/features": [
      "common", "distribution", "protocol", "data", "persistence", "auth", "net", "world/core"
    ],
    "world/session": [
      "common", "distribution", "protocol", "data", "persistence", "auth", "net", "world/core",
      "world/features"
    ],
    "services": [
      "common", "distribution", "protocol", "data", "persistence", "auth", "net", "world/core",
      "world/features", "world/session"
    ],
    "apps": [
      "common", "distribution", "protocol", "data", "persistence", "auth", "net", "world/core",
      "world/features", "world/session", "services"
    ],
    "testing": [
      "common", "distribution", "protocol", "data", "persistence", "auth", "net", "world/core",
