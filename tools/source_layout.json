{
  "format_version": 1,
  "description": "Module folders under src/ (docs/superpowers/specs/2026-10-27-modular-emulator-architecture-design.md section 3). Modules are folders under src/; a file belongs to the longest module folder that contains it. Test files go to <module>/tests/, except in testing/. Allowed layer-to-layer includes are listed in layer_dependencies; each module folder has a CMakeLists.txt calling chronicles_add_module, whose DEPENDS list is the single record of the modules it includes (apps, the executables folder, has no call).",
  "layers": [
    "common",
    "distribution",
    "protocol",
    "data",
    "persistence",
    "auth",
    "net",
    "world/core",
    "world/features",
    "world/session",
    "services",
    "apps",
    "testing"
  ],
