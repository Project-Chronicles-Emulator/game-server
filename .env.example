# Export these in your shell; the server does not automatically load .env files.
# Use a dedicated database owned by your emulator development role.
CHRONICLES_DATABASE_URL=host=127.0.0.1 port=5432 dbname=chronicles user=chronicles connect_timeout=5
CHRONICLES_BOOTSTRAP_ACCOUNT=developer
CHRONICLES_BOOTSTRAP_PASSWORD=replace-with-your-own-password-at-least-12-characters
